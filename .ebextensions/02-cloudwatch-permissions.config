# Attach CloudWatch Logs, Metrics, and X-Ray Traces permissions to the EB
# instance profile role and create the log group/stream for the OTLP demo.
#
# This uses CloudFormation IAM Policy resources attached to the
# instance profile role that EB creates (aws-elasticbeanstalk-ec2-role).
#
# IAM is a GLOBAL service, so `aws-elasticbeanstalk-ec2-role` is shared
# across every region in your account. Inline policy names must be unique
# per role, so we prefix each PolicyName with ${AWS::StackName}. That
# gives every EB environment (in every region) its own uniquely-named
# inline policy attached to the shared role, and CloudFormation cleans
# them up automatically when the environment is terminated.

Resources:
  OtelCloudWatchLogsPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Sub: "${AWS::StackName}-OtelDirectLogsAccess"
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - logs:CreateLogGroup
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogGroups
              - logs:DescribeLogStreams
              - logs:PutRetentionPolicy
            Resource: "arn:aws:logs:*:*:log-group:/otel/demo/*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

  OtelCloudWatchMetricsPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Sub: "${AWS::StackName}-OtelDirectMetricsAccess"
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - cloudwatch:PutMetricData
            Resource: "*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

  OtelXRayTracesPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName:
        Fn::Sub: "${AWS::StackName}-OtelDirectTracesAccess"
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - xray:PutTraceSegments
              - xray:PutTelemetryRecords
            Resource: "*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

# The `--region` flag is intentionally omitted. During `.ebextensions`
# command execution the shell env var `AWS_REGION` is not populated, so a
# fallback like `${AWS_REGION:-us-east-1}` silently targets us-east-1 from
# every region. The AWS CLI itself resolves the region from IMDS when no
# --region is given, which is what we want here.
commands:
  01_create_log_group:
    command: |
      aws logs create-log-group --log-group-name /otel/demo/direct-logs || true
  02_create_log_stream:
    command: |
      aws logs create-log-stream --log-group-name /otel/demo/direct-logs --log-stream-name flask-app || true
  03_set_log_group_retention:
    command: |
      aws logs put-retention-policy --log-group-name /otel/demo/direct-logs --retention-in-days 30 || true
