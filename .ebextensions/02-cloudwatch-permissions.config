# Attach CloudWatch Logs, Metrics, and X-Ray Traces permissions to the EB
# instance profile role and create the log group/stream for the OTLP demo.
#
# This uses CloudFormation IAM Policy resources attached to the
# instance profile role that EB creates (aws-elasticbeanstalk-ec2-role).

Resources:
  OtelCloudWatchLogsPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName: OtelDirectLogsAccess
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - logs:CreateLogGroup
              - logs:CreateLogStream
              - logs:PutLogEvents
              - logs:DescribeLogGroups
              - logs:DescribeLogStreams
              - logs:PutRetentionPolicy
            Resource: "arn:aws:logs:*:*:log-group:/otel/demo/*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

  OtelCloudWatchMetricsPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName: OtelDirectMetricsAccess
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - cloudwatch:PutMetricData
            Resource: "*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

  OtelXRayTracesPolicy:
    Type: AWS::IAM::Policy
    Properties:
      PolicyName: OtelDirectTracesAccess
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Action:
              - xray:PutTraceSegments
              - xray:PutTelemetryRecords
            Resource: "*"
      Roles:
        - aws-elasticbeanstalk-ec2-role

commands:
  01_create_log_group:
    command: |
      aws logs create-log-group --log-group-name /otel/demo/direct-logs --region ${AWS_REGION:-us-east-1} || true
  02_create_log_stream:
    command: |
      aws logs create-log-stream --log-group-name /otel/demo/direct-logs --log-stream-name flask-app --region ${AWS_REGION:-us-east-1} || true
  03_set_log_group_retention:
    command: |
      aws logs put-retention-policy --log-group-name /otel/demo/direct-logs --retention-in-days 30 --region ${AWS_REGION:-us-east-1} || true
